<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>StandWatch-Portable</AssemblyName>
    <RootNamespace>StandWatch.Portable</RootNamespace>
    <Version>1.0.0</Version>
    <StandWatchPayloadVersion Condition="'$(StandWatchPayloadVersion)' == ''">development</StandWatchPayloadVersion>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="payload.zip" />
    <AssemblyMetadata Include="StandWatchPayloadVersion" Value="$(StandWatchPayloadVersion)" />
  </ItemGroup>
</Project>
